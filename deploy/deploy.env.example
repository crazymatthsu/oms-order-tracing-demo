# Deployment settings for a Podman on-prem Deephaven Enterprise cluster (docs/deployment.md).
# Copy to deploy/deploy.env (git-ignored) and fill in. NO SECRETS HERE: passwords, Kafka SASL
# credentials, AMPS passwords and private keys stay in the environment's secret store or in files
# referenced by path; the scripts never print or copy them.

# --- where dhconfig runs ---------------------------------------------------------------------
# Either run the scripts on the infra node as irisadmin (dhconfig on PATH), or from a host and
# let every call go through the infra container:
#   DHCONFIG="podman exec -i deephaven-infra dhconfig"
DHCONFIG=dhconfig

# --- the cluster ------------------------------------------------------------------------------
# The cluster's connection.json (the Core+ client and the controller client read it).
DH_CONNECTION_JSON_URL=https://deephaven-infra.example.com:8000/iris/connection.json
# Service account that owns the oms-* PQs (docs/design/07 section 5) and its private key file
# (generated with the Enterprise key generator; the public key is registered to the account).
DH_SERVICE_USER=oms-trace-svc
DH_SERVICE_KEYFILE=/etc/deephaven/secrets/oms-trace-svc.pem
# Groups (docs/design/07 section 5)
DH_ADMIN_GROUPS=oms-trace-ops
DH_VIEWER_GROUPS=oms-desk-a,oms-desk-b,oms-desk-c
# The dispatchers the PQs run on, as the Query Monitor names them (docs/design/07 section 2: query / merge).
QUERY_SERVER=Query_1
MERGE_SERVER=Merge_1
# Expected release (docs/design/01 Q10); check_env.sh compares `dhconfig version` and the Core+ wheel against it.
DH_EXPECTED_VERSION=2026.01.054

# --- storage ----------------------------------------------------------------------------------
# Private DIS storage root on the shared filesystem the merge and query nodes mount (docs/design/05 section 2).
DIS_STORAGE_ROOT=/db/dataImportServers

# --- the scripts' Git repository, as the controller sees it (docs/git-persistent-query-scripts.md)
GIT_REPO_NAME=oms_trace
GIT_REPO_URI=git@github.com:crazymatthsu/oms-order-tracing-demo.git
GIT_REPO_BRANCH=main
# A persistent location under the host-mounted volume (survives container restarts).
GIT_REPO_ROOT=/db/TempFiles/irisadmin/git/oms_trace
# Groups allowed to pick the scripts in the Query Monitor
GIT_REPO_GROUPS=oms-trace-ops,oms-trace-svc

# --- the Python package in the workers ---------------------------------------------------------
# The Core+ Python environment every query and merge node runs workers from (confirm the path on
# the installed release: `grep -r venv /etc/sysconfig/deephaven/illumon.d*/resources/*.prop`).
COREPLUS_VENV=/usr/illumon/dnd/venv
# Nodes to install the wheel on (space separated; ssh as a user that may sudo to irisadmin).
WORKER_NODES="query-1 query-2 merge-1"

# --- settings the PQs receive (docs/design/03 section 8, 07 section 8); secrets referenced, not held
OMS_TRACE_TZ=America/New_York
OMS_TOPICS_A=oms.a.t1,oms.a.t2
OMS_TOPICS_B=oms.b.t1,oms.b.t2,oms.b.t3
OMS_TOPICS_C=oms.c.t1,oms.c.t2,oms.c.t3
KAFKA_BOOTSTRAP=kafka-1:9093,kafka-2:9093
# Kafka security properties come from the secret store as KAFKA_PROP_* variables on the PQ (queries/oms_trace/ingest.py).
# AMPS instead of Kafka (docs/design/11): set the URI (credentials from the secret store) and the SOW topics.
OMS_AMPS_URI=
# The topics carry FIX 4.2 execution reports (docs/design/11 D18): the standard tags feed the raw columns of
# the same name; the firm's own tags for the two link columns are configured per system (tag=Column,...).
# A's destination order names its client order in 5011; B's and C's tags have no default: FILL THEM IN
# (read them off a sample with trace_check) or the ingester PQ refuses to start.
OMS_AMPS_FORMAT=fix
OMS_AMPS_TAG_MAP_A=5011=ParentOrderID
OMS_AMPS_TAG_MAP_B=
OMS_AMPS_TAG_MAP_C=
# The AMPS ingesters' bookmark stores (docs/design/11 D17): on the shared filesystem, one file per PQ.
OMS_AMPS_BOOKMARK_DIR=/db/dataImportServers/oms_amps_bookmarks
OMS_TRACE_ALERT_URL=
