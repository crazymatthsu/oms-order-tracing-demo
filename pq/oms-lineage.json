{
  "name": "oms-lineage",
  "description": "The lineage DAG over OMS_RAW.Orders{A,B,C} (docs/design/04): every table of doc 03 section 4, break events, alerts and the sink. Heap from doc 06 section 1.3 (96 GB expected case); the init timeout must exceed the measured recovery time with margin (doc 06 section 8).",
  "type": "Live Query (Script)",
  "dispatcher": "query",
  "script": "queries/oms_trace/lineage.py",
  "heap_gb": 64,
  "daily_restart": "00:15",
  "restart_attempts": 3,
  "restart_delay_sec": 60,
  "init_timeout_sec": 3600,
  "jvm_args": [
    "-XX:MaxGCPauseMillis=200"
  ],
  "env": {
    "OMS_TRACE_SOURCE": "enterprise",
    "OMS_TOPICS_A": "${OMS_TOPICS_A}",
    "OMS_TOPICS_B": "${OMS_TOPICS_B}",
    "OMS_TOPICS_C": "${OMS_TOPICS_C}",
    "OMS_TRACE_ONE_TABLE_PER_SYSTEM": "true",
    "OMS_TRACE_ALERT_URL": "${OMS_TRACE_ALERT_URL:-}",
    "OMS_TRACE_MARKET_HOURS": "${OMS_TRACE_MARKET_HOURS:-09:30-16:00}",
    "OMS_TRACE_TZ": "${OMS_TRACE_TZ}",
    "OMS_TRACE_SRC": "${OMS_TRACE_SRC:-}"
  }
}
