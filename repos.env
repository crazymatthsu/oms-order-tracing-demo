# =====================================================================================
# repos.env -- EVERY external artifact source this repo uses, in one file.
# =====================================================================================
# Container images and Python packages come from the keys below; nothing else in the repo
# names a public registry. DO NOT EDIT THIS FILE FOR YOUR COMPANY: put JFrog URLs in an
# override file (cp repos.local.env.example repos.local.env, git-ignored) or point REPOS_ENV
# at one file shared by all projects. Precedence, first definition wins:
#   environment variable  >  override file  >  this file.
# Loaded by every script through scripts/repos.sh; check with: scripts/repos.sh show
# =====================================================================================

# ---- container registries ------------------------------------------------------------
#   JFrog examples: mycompany.jfrog.io/ghcr-remote, mycompany.jfrog.io/dockerhub-remote
GHCR_REGISTRY=ghcr.io
DOCKERHUB_REGISTRY=docker.io

# ---- container images (registry prefix above + pinned tag) --------------------------
# Community Core 42.5: the engine Deephaven Enterprise 1.202601 bundles (docs/design/01 Q10).
DEEPHAVEN_IMAGE=${GHCR_REGISTRY}/deephaven/server:42.5
KAFKA_IMAGE=${DOCKERHUB_REGISTRY}/apache/kafka:3.9.1
KAFKA_UI_IMAGE=${DOCKERHUB_REGISTRY}/kafbat/kafka-ui:v1.5.0
# The AMPS broker of the demo overlay (docker/docker-compose.amps.yml, docs/design/11). 60East ships
# AMPS to licensees and publishes no image: the default names one built locally from the
# distribution; a company points this at the image in its own registry.
AMPS_IMAGE=localhost/amps-demo:5.3.5.135

# ---- Python packages (pip, on the host and inside image builds) ----------------------
#   JFrog example: https://mycompany.jfrog.io/artifactory/api/pypi/pypi-remote/simple
PIP_INDEX_URL=https://pypi.org/simple
# Only for a mirror whose TLS certificate pip cannot verify; empty = off.
PIP_TRUSTED_HOST=
